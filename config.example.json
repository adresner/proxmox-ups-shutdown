{
  "_comment": "Copy to config.json and edit. Hosts list can be empty to start; add via web UI or `./manage.py add`.",
  "ups_name": "ups-main",
  "thresholds": {
    "mode": "percent",
    "vm_shutdown_pct": 60,
    "host_shutdown_pct": 20,
    "vm_shutdown_min": 10,
    "host_shutdown_min": 4
  },
  "ssh": {
    "user": "root",
    "connect_timeout": 5,
    "key_path": "/root/.ssh/id_rsa"
  },
  "hosts": [
    {
      "ip": "10.0.0.21",
      "label": "pve-01",
      "enabled": true,
      "note": "example - replace with your hosts"
    },
    {
      "ip": "10.0.0.22",
      "label": "pve-02",
      "enabled": false,
      "note": "example - disabled"
    }
  ],
  "paths": {
    "state_file": "/var/run/power_state",
    "log_file": "/var/log/power_monitor.log"
  },
  "web": {
    "bind": "0.0.0.0",
    "port": 8080,
    "username": "admin",
    "password": "CHANGE_ME_BEFORE_STARTING"
  },
  "notifications": {
    "smtp_host": "",
    "smtp_port": 25,
    "smtp_user": "",
    "smtp_password": "",
    "smtp_use_tls": false,
    "from_address": "",
    "to_addresses": [],
    "warning_pct": 80,
    "events": {
      "warning": true,
      "guests_shutdown": true,
      "hosts_shutdown": true,
      "power_restored": true
    }
  },
  "selftest": {
    "enabled": true,
    "hour": 7,
    "email_on_success": false
  }
}
